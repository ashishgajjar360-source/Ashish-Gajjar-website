---
import "../style/global.css";
import { getCollection } from "astro:content";
import "../style/specificwork.css";

const obsidianProjects = await getCollection("specificwork");

const projects = obsidianProjects.map((entry, idx) => {
  let mediaType = entry.data.mediaType;
  if (!mediaType && entry.id.includes("/")) {
    const parts = entry.id.split("/");
    if (parts[0].toLowerCase().includes("print")) {
      mediaType = "Print Media";
    } else if (parts[0].toLowerCase().includes("digital")) {
      mediaType = "Digital Media";
    }
  }
  if (!mediaType) {
    mediaType = "Print Media";
  }

  let category = entry.data.category || (entry.data.tags && entry.data.tags[0]);
  if (!category && entry.id.includes("/")) {
    const parts = entry.id.split("/");
    if (parts.length > 1) {
      category = parts[1];
    }
  }
  if (!category) {
    category = "Branding";
  }

  const filename = entry.id.split("/").pop()?.replace(/\.md$/, "") || "";
  const title =
    entry.data.title || filename.replace(/[-_]/g, " ") || "Untitled Project";

  let rawImage = entry.data.image || entry.data.img;
  let image: string | undefined = undefined;
  if (rawImage) {
    let cleaned = String(rawImage)
      .replace(/["']/g, "")
      .replace(/\\/g, "/")
      .trim();
    if (cleaned.startsWith("Image/") || cleaned.startsWith("Images/")) {
      cleaned = "/" + cleaned;
    } else if (!cleaned.startsWith("/") && !cleaned.startsWith("http")) {
      cleaned = "/Images/" + cleaned;
    }
    image = cleaned;
  }

  return {
    id: entry.id,
    slug: entry.id,
    title,
    mediaType,
    category,
    image,
    isHero: entry.data.isHero || false,
    aspect: String(entry.data.aspectRatio || "3/4"),
    col: entry.data.col || (idx % 2) + 1,
    description: entry.data.description,
  };
});

const heroProject = projects.find((p) => p.isHero) || projects[0];
const subProjects = projects.filter((p) => p !== heroProject);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>Work — Ashish Gajjar</title>
  </head>
  <body>
    <main class="specific-page">
      <!-- Top Navigation -->
      <nav class="top-nav" aria-label="Main Navigation">
        <div class="top-nav__left">
          <a href="/work" class="top-nav__link-left" id="nav-work-left"
            >• Work</a
          >
        </div>
        <div class="top-nav__right">
          <a href="/" class="top-nav__link-right" id="nav-home">Home</a>
          <a href="/work" class="top-nav__link-right" id="nav-work">Work</a>
          <a href="/posts" class="top-nav__link-right" id="nav-dp">DP</a>
          <a
            href="/collections"
            class="top-nav__link-right"
            id="nav-collections">Collections</a
          >
        </div>
      </nav>

      {
        projects.length === 0 ? (
          <div class="empty-posts">
            <p class="empty-posts__message">no uploads</p>
          </div>
        ) : (
          <div class="showcase-container" data-showcase-container>
            {heroProject && (
              <a
                href={`/specificwork/${heroProject.slug}`}
                class="layout-card hero-container"
                aria-label={`View ${heroProject.title}`}
              >
                {heroProject.image ? (
                  <img
                    src={heroProject.image}
                    alt={heroProject.title}
                    class="post-card__img"
                    style="width: 100%; height: 100%; object-fit: cover;"
                  />
                ) : (
                  <div class="visual-placeholder">
                    <span>{heroProject.title}</span>
                  </div>
                )}
              </a>
            )}

            <section class="sub-projects-grid" aria-label="Sub project visuals">
              <div class="sub-projects-col" data-col>
                <div class="sub-projects-col-inner">
                  {subProjects
                    .filter((p) => p.col === 1)
                    .map((p) => (
                      <a
                        href={`/specificwork/${p.slug}`}
                        class="layout-card"
                        aria-label={`View ${p.title}`}
                      >
                        {p.image ? (
                          <img
                            src={p.image}
                            alt={p.title}
                            class="post-card__img"
                            style="width: 100%; height: 100%; object-fit: cover;"
                          />
                        ) : (
                          <div class="visual-placeholder">
                            <span>{p.title}</span>
                          </div>
                        )}
                      </a>
                    ))}
                  {subProjects
                    .filter((p) => p.col === 1)
                    .map((p) => (
                      <a
                        href={`/specificwork/${p.slug}`}
                        class="layout-card"
                        tabindex="-1"
                        aria-hidden="true"
                      >
                        {p.image ? (
                          <img
                            src={p.image}
                            alt={p.title}
                            class="post-card__img"
                            style="width: 100%; height: 100%; object-fit: cover;"
                          />
                        ) : (
                          <div class="visual-placeholder">
                            <span>{p.title}</span>
                          </div>
                        )}
                      </a>
                    ))}
                </div>
              </div>

              <div class="sub-projects-col" data-col>
                <div class="sub-projects-col-inner">
                  {subProjects
                    .filter((p) => p.col === 2)
                    .map((p) => (
                      <a
                        href={`/specificwork/${p.slug}`}
                        class="layout-card"
                        aria-label={`View ${p.title}`}
                      >
                        {p.image ? (
                          <img
                            src={p.image}
                            alt={p.title}
                            class="post-card__img"
                            style="width: 100%; height: 100%; object-fit: cover;"
                          />
                        ) : (
                          <div class="visual-placeholder">
                            <span>{p.title}</span>
                          </div>
                        )}
                      </a>
                    ))}
                  {subProjects
                    .filter((p) => p.col === 2)
                    .map((p) => (
                      <a
                        href={`/specificwork/${p.slug}`}
                        class="layout-card"
                        tabindex="-1"
                        aria-hidden="true"
                      >
                        {p.image ? (
                          <img
                            src={p.image}
                            alt={p.title}
                            class="post-card__img"
                            style="width: 100%; height: 100%; object-fit: cover;"
                          />
                        ) : (
                          <div class="visual-placeholder">
                            <span>{p.title}</span>
                          </div>
                        )}
                      </a>
                    ))}
                </div>
              </div>
            </section>

            <div class="scroll-mimic" />
          </div>
        )
      }
    </main>

    <script is:inline>
      const container = document.querySelector("[data-showcase-container]");
      const heroContainer = document.querySelector(".hero-container");
      const columns = document.querySelectorAll("[data-col]");

      if (container && columns.length > 0) {
        const colStates = Array.from(columns).map((col) => {
          const inner = col.querySelector(".sub-projects-col-inner");
          const cards = inner
            ? inner.querySelectorAll(".layout-card:not([aria-hidden])")
            : [];
          return {
            element: col,
            inner: inner,
            cards: cards,
            groupHeight: 0,
          };
        });

        const measureColumns = () => {
          colStates.forEach((state) => {
            if (!state.inner) return;
            let h = 0;
            state.cards.forEach((card) => {
              h += card.getBoundingClientRect().height;
            });
            const gap = parseFloat(getComputedStyle(state.inner).gap) || 32;
            h += gap * state.cards.length;
            state.groupHeight = h;
          });
        };

        const measureHeroLimit = () => {
          if (!heroContainer) return 0;
          const rect = heroContainer.getBoundingClientRect();
          return rect.height + 32;
        };

        const setInitialPositions = () => {
          measureColumns();
          colStates.forEach((state) => {
            if (state.groupHeight > 0) {
              state.element.scrollTop = 0;
            }
          });
        };

        const syncScroll = () => {
          const currentScrollTop = container.scrollTop;
          const heroScrollLimit = measureHeroLimit();
          const firstCol = colStates[0];

          colStates.forEach((state) => {
            if (state.groupHeight === 0) return;

            if (currentScrollTop < heroScrollLimit) {
              state.element.scrollTop = 0;
            } else {
              const activeScroll = currentScrollTop - heroScrollLimit;
              const newScrollTop = activeScroll % state.groupHeight;
              state.element.scrollTop = newScrollTop;
            }
          });

          if (currentScrollTop > 8000 && firstCol && firstCol.groupHeight > 0) {
            const loopOffset =
              Math.floor((8000 - heroScrollLimit) / firstCol.groupHeight) *
              firstCol.groupHeight;
            container.scrollTop = currentScrollTop - loopOffset;
          }
        };

        setInitialPositions();
        container.scrollTop = 0;

        document.addEventListener(
          "wheel",
          (e) => {
            if (window.innerWidth > 900) {
              container.scrollTop += e.deltaY;
            }
          },
          { passive: true },
        );

        container.addEventListener("scroll", syncScroll, { passive: true });
        window.addEventListener("load", () => {
          setInitialPositions();
        });
        window.addEventListener("resize", () => {
          measureColumns();
        });
      }
    </script>
  </body>
</html>

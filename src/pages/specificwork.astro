---
import { getCollection } from "astro:content";
import "../Style/global.css";
import "../Style/specificwork.css";
import HeaderNav from "../components/HeaderNav.astro";

const obsidianProjects = await getCollection("specificwork");

const projects = obsidianProjects.map((entry, idx) => {
  let mediaType = entry.data.mediaType;
  if (!mediaType && entry.id.includes("/")) {
    const parts = entry.id.split("/");
    if (parts[0].toLowerCase().includes("print")) {
      mediaType = "Print Media";
    } else if (parts[0].toLowerCase().includes("digital")) {
      mediaType = "Digital Media";
    }
  }
  if (!mediaType) {
    mediaType = "Print Media";
  }

  let category = entry.data.category || (entry.data.tags && entry.data.tags[0]);
  if (!category && entry.id.includes("/")) {
    const parts = entry.id.split("/");
    if (parts.length > 1) {
      category = parts[1];
    }
  }
  if (!category) {
    category = "Branding";
  }

  const filename = entry.id.split("/").pop()?.replace(/\.md$/, "") || "";
  const title =
    entry.data.title || filename.replace(/[-_]/g, " ") || "Untitled Project";

  let rawImage = entry.data.image || entry.data.img;
  let image: string | undefined = undefined;
  if (rawImage) {
    let cleaned = String(rawImage)
      .replace(/["']/g, "")
      .replace(/\\/g, "/")
      .trim();
    if (cleaned.startsWith("Image/") || cleaned.startsWith("Images/")) {
      cleaned = "/" + cleaned;
    } else if (!cleaned.startsWith("/") && !cleaned.startsWith("http")) {
      cleaned = "/Images/" + cleaned;
    }
    image = cleaned;
  }

  return {
    id: entry.id,
    slug: entry.id,
    title,
    mediaType,
    category,
    image,
    isHero: entry.data.isHero || false,
    aspect: String(entry.data.aspectRatio || "3/4"),
    col: entry.data.col || (idx % 2) + 1,
    description: entry.data.description,
  };
});

const heroProject = projects.find((p) => p.isHero) || projects[0];
const subProjects = projects.filter((p) => p !== heroProject);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>Work — Ashish Gajjar</title>
  </head>
  <body>
    <main class="specific-page">
      <HeaderNav currentLabel="Work" currentHref="/work" />

      {
        projects.length === 0 ? (
          <div class="empty-posts">
            <p class="empty-posts__message">no uploads</p>
          </div>
        ) : (
          <div class="showcase-container" data-showcase-container>
            {heroProject && (
              <a
                href={`/specificwork/${heroProject.slug}`}
                class="layout-card hero-container"
                aria-label={`View ${heroProject.title}`}
              >
                {heroProject.image ? (
                  <img
                    src={heroProject.image}
                    alt={heroProject.title}
                    class="post-card__img"
                    style="width: 100%; height: 100%; object-fit: cover;"
                  />
                ) : (
                  <div class="visual-placeholder">
                    <span>{heroProject.title}</span>
                  </div>
                )}
              </a>
            )}

            <section class="sub-projects-grid" aria-label="Sub project visuals">
              <div class="sub-projects-col" data-col>
                <div class="sub-projects-col-inner">
                  {subProjects
                    .filter((p) => p.col === 1)
                    .map((p) => (
                      <a
                        href={`/specificwork/${p.slug}`}
                        class="layout-card"
                        aria-label={`View ${p.title}`}
                      >
                        {p.image ? (
                          <img
                            src={p.image}
                            alt={p.title}
                            class="post-card__img"
                            style="width: 100%; height: 100%; object-fit: cover;"
                          />
                        ) : (
                          <div class="visual-placeholder">
                            <span>{p.title}</span>
                          </div>
                        )}
                      </a>
                    ))}
                  {subProjects
                    .filter((p) => p.col === 1)
                    .map((p) => (
                      <a
                        href={`/specificwork/${p.slug}`}
                        class="layout-card"
                        tabindex="-1"
                        aria-hidden="true"
                      >
                        {p.image ? (
                          <img
                            src={p.image}
                            alt={p.title}
                            class="post-card__img"
                            style="width: 100%; height: 100%; object-fit: cover;"
                          />
                        ) : (
                          <div class="visual-placeholder">
                            <span>{p.title}</span>
                          </div>
                        )}
                      </a>
                    ))}
                </div>
              </div>

              <div class="sub-projects-col" data-col>
                <div class="sub-projects-col-inner">
                  {subProjects
                    .filter((p) => p.col === 2)
                    .map((p) => (
                      <a
                        href={`/specificwork/${p.slug}`}
                        class="layout-card"
                        aria-label={`View ${p.title}`}
                      >
                        {p.image ? (
                          <img
                            src={p.image}
                            alt={p.title}
                            class="post-card__img"
                            style="width: 100%; height: 100%; object-fit: cover;"
                          />
                        ) : (
                          <div class="visual-placeholder">
                            <span>{p.title}</span>
                          </div>
                        )}
                      </a>
                    ))}
                  {subProjects
                    .filter((p) => p.col === 2)
                    .map((p) => (
                      <a
                        href={`/specificwork/${p.slug}`}
                        class="layout-card"
                        tabindex="-1"
                        aria-hidden="true"
                      >
                        {p.image ? (
                          <img
                            src={p.image}
                            alt={p.title}
                            class="post-card__img"
                            style="width: 100%; height: 100%; object-fit: cover;"
                          />
                        ) : (
                          <div class="visual-placeholder">
                            <span>{p.title}</span>
                          </div>
                        )}
                      </a>
                    ))}
                </div>
              </div>
            </section>

            <div class="scroll-mimic" />
          </div>
        )
      }
    </main>

    <script is:inline>
      (() => {
        const container = document.querySelector("[data-showcase-container]");
        const heroContainer = document.querySelector(".hero-container");
        const columns = document.querySelectorAll("[data-col]");

        if (!container || columns.length === 0) return;

        const colStates = Array.from(columns).map((col) => {
          const inner = col.querySelector(".sub-projects-col-inner");
          const cards = inner
            ? Array.from(inner.querySelectorAll(".layout-card:not([aria-hidden])"))
            : [];
          // Enable GPU layer for smooth transforms
          if (inner) inner.style.willChange = "transform";
          return { element: col, inner, cards, groupHeight: 0 };
        });

        let heroScrollLimit = 0;
        let targetScroll = 0;
        let currentScroll = 0;
        let animating = false;
        const LERP = 0.08;
        const SCROLL_SPEED = 0.5;

        const measure = () => {
          colStates.forEach((state) => {
            if (!state.inner) return;
            let h = 0;
            state.cards.forEach((card) => {
              h += card.getBoundingClientRect().height;
            });
            const gap = parseFloat(getComputedStyle(state.inner).gap) || 32;
            h += gap * state.cards.length;
            state.groupHeight = h;
          });
          if (heroContainer) {
            heroScrollLimit = heroContainer.offsetHeight + 32;
          }
        };

        /* Use translateY instead of scrollTop — runs on GPU, no layout thrash */
        const syncColumns = (scrollY) => {
          colStates.forEach((state) => {
            if (!state.inner || state.groupHeight <= 0) return;
            let offset = 0;
            if (scrollY >= heroScrollLimit) {
              offset = -((scrollY - heroScrollLimit) % state.groupHeight);
            }
            state.inner.style.transform = "translateY(" + offset + "px)";
          });
        };

        const animate = () => {
          currentScroll += (targetScroll - currentScroll) * LERP;

          if (Math.abs(targetScroll - currentScroll) < 0.5) {
            currentScroll = targetScroll;
          }

          const maxScroll = container.scrollHeight - container.clientHeight;
          currentScroll = Math.max(0, Math.min(currentScroll, maxScroll));

          container.scrollTop = currentScroll;
          syncColumns(currentScroll);

          // Reset to avoid 10,000px limit
          const first = colStates[0];
          if (first && first.groupHeight > 0 && currentScroll > 6000) {
            const remainder = (currentScroll - heroScrollLimit) % first.groupHeight;
            const resetTo = heroScrollLimit + remainder;
            if (currentScroll - resetTo > first.groupHeight) {
              currentScroll = resetTo;
              targetScroll = resetTo;
              container.scrollTop = resetTo;
            }
          }

          if (Math.abs(targetScroll - currentScroll) > 0.5) {
            requestAnimationFrame(animate);
          } else {
            animating = false;
          }
        };

        const startAnimation = () => {
          if (!animating) {
            animating = true;
            requestAnimationFrame(animate);
          }
        };

        document.addEventListener(
          "wheel",
          (e) => {
            if (window.innerWidth <= 900) return;
            e.preventDefault();
            targetScroll += e.deltaY * SCROLL_SPEED;
            const maxScroll = container.scrollHeight - container.clientHeight;
            targetScroll = Math.max(0, Math.min(targetScroll, maxScroll));
            startAnimation();
          },
          { passive: false },
        );

        container.addEventListener(
          "scroll",
          () => {
            if (!animating) {
              currentScroll = container.scrollTop;
              targetScroll = currentScroll;
              syncColumns(currentScroll);
            }
          },
          { passive: true },
        );

        const init = () => {
          measure();
          container.scrollTop = 0;
          currentScroll = 0;
          targetScroll = 0;
        };

        const images = container.querySelectorAll("img");
        let loaded = 0;
        const onImgLoad = () => {
          loaded++;
          if (loaded >= images.length) measure();
        };
        images.forEach((img) => {
          if (img.complete) {
            loaded++;
          } else {
            img.addEventListener("load", onImgLoad);
            img.addEventListener("error", onImgLoad);
          }
        });

        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", init);
        } else {
          init();
        }
        window.addEventListener("load", measure);
        window.addEventListener("resize", measure);
      })();
    </script>
  </body>
</html>

---
import "../Style/global.css";
import "../Style/home-card.css";
import HomeCard from "../components/HomeCard.astro";

const cards = [
  {
    eyebrow: "Home",
    title: "Space",
    intro: ["Hello,", "I am Ashish Gajjar,", "& this is my web"],
    tagline: ["Living archive of ideas,", "pursuit of Better Design."],
    href: "/",
  },
  {
    eyebrow: "Work",
    title: "Rhythm",
    intro: ["Selected work,", "shaping motion,", "layout, and flow"],
    tagline: ["A focused collection of", "visual experiments."],
    href: "/work",
  },
  {
    eyebrow: "Posts",
    title: "Form",
    intro: ["Ideas in progress,", "refined through", "spacing and contrast"],
    tagline: ["Simple systems with", "a strong graphic edge."],
    href: "/posts",
  },
];

// Repeat 5 times for smooth infinite looping on home page
const loopedCards = Array(5).fill(cards).flat();
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>Ashish Gajjar's Portfolio</title>
  </head>
  <body>
    <main class="frame">
      <!-- 3D Perspective Grid Background (Ceiling & Floor) -->
      <div class="perspective-bg" aria-hidden="true">
        <div class="perspective-grid--top"></div>
        <div class="perspective-grid--bottom"></div>
      </div>

      <section class="scroller" aria-label="Horizontal portfolio cards">
        <div
          class="scroller__viewport"
          data-scroller-viewport
          data-count={cards.length}
        >
          <div class="scroller__track" data-scroller-track>
            {loopedCards.map((card) => <HomeCard {...card} />)}
          </div>
        </div>
      </section>
    </main>

    <script is:inline>
      const viewport = document.querySelector("[data-scroller-viewport]");
      const track = document.querySelector("[data-scroller-track]");
      const cards = document.querySelectorAll(".card");

      if (viewport && track) {
        let frameId = 0;
        const cardCount = parseInt(viewport.dataset.count || "3", 10);

        const checkLoop = () => {
          if (cards.length < cardCount * 3) return;
          const setLength = cards[cardCount].offsetLeft - cards[0].offsetLeft;
          if (!setLength) return;

          if (viewport.scrollLeft < setLength * 1) {
            viewport.scrollLeft += setLength * 2;
          } else if (viewport.scrollLeft > setLength * 3) {
            viewport.scrollLeft -= setLength * 2;
          }
        };

        const initLoopScroll = () => {
          if (cards.length >= cardCount * 3) {
            const setLength = cards[cardCount].offsetLeft - cards[0].offsetLeft;
            if (setLength && viewport.scrollLeft === 0) {
              const midCardIndex = cardCount * 2; // start of middle set
              viewport.scrollLeft =
                cards[midCardIndex].offsetLeft -
                (viewport.clientWidth - cards[midCardIndex].offsetWidth) / 2;
            }
          }
        };

        const updateCardPerspective = () => {
          frameId = 0;
          if (!cards.length) return;

          const viewportRect = viewport.getBoundingClientRect();
          const viewportCenter = viewportRect.left + viewportRect.width / 2;

          cards.forEach((card) => {
            const rect = card.getBoundingClientRect();
            const cardCenter = rect.left + rect.width / 2;
            const offset =
              (cardCenter - viewportCenter) / (viewportRect.width / 2 || 1);
            const distance = Math.min(1, Math.abs(offset));
            const direction = offset < 0 ? 1 : -1;
            const rotateY = direction * distance * 20;
            const scale = 1 - distance * 0.08;

            card.style.setProperty("--card-rotate", `${rotateY.toFixed(2)}deg`);
            card.style.setProperty("--card-scale", scale.toFixed(3));
          });
        };

        const requestCardPerspectiveUpdate = () => {
          if (!frameId) {
            frameId = window.requestAnimationFrame(updateCardPerspective);
          }
        };

        initLoopScroll();
        updateCardPerspective();

        viewport.addEventListener(
          "scroll",
          () => {
            checkLoop();
            requestCardPerspectiveUpdate();
          },
          { passive: true },
        );

        window.addEventListener("load", () => {
          initLoopScroll();
          updateCardPerspective();
        });

        window.addEventListener(
          "resize",
          () => {
            updateCardPerspective();
          },
          { passive: true },
        );
      }
    </script>
  </body>
</html>

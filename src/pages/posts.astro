---
import { getCollection } from "astro:content";
import "../Style/global.css";
import "../Style/home-card.css";
import "../Style/posts.css";

const obsidianPosts = await getCollection("posts");

const posts = obsidianPosts.map((entry, idx) => ({
  id: entry.id,
  slug: entry.id,
  title: entry.data.title,
  category: entry.data.category,
  image: entry.data.image,
  aspect: entry.data.aspectRatio || "3/4",
  col: entry.data.col || ((idx % 3) + 1),
  description: entry.data.description,
}));

// Build unique categories list dynamically from Obsidian posts
const categoryList = Array.from(new Set(posts.map((p) => p.category)));
const categories = categoryList.map((label, idx) => ({
  label,
  active: idx === 0,
}));
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>Posts — Ashish Gajjar</title>
  </head>
  <body>
    <main class="posts-page">
      <!-- Back Button -->
      <a href="/" class="back-button" id="back-to-home" aria-label="Back to Home">
        ←
      </a>

      {posts.length === 0 ? (
        <div class="empty-posts">
          <p class="empty-posts__message">no uploads</p>
        </div>
      ) : (
        <>
          <!-- scrollable wrapper -->
          <div class="masonry-container" data-masonry-container>
            <!-- masonry grid -->
            <div class="masonry">
              <!-- column 1 -->
              <div class="masonry__col" data-col>
                <div class="masonry__col-inner">
                  {posts.filter(p => p.col === 1).map(p => (
                    <a href={`/posts/${p.slug}`} class="post-card" aria-label={`View ${p.title}`}>
                      <div class="post-card__image-container" style={`aspect-ratio: ${p.aspect};`}>
                        {p.image ? (
                          <img src={p.image} alt={p.title} class="post-card__img" loading="lazy" />
                        ) : (
                          <div class="post-card__placeholder">
                            <span class="post-card__placeholder-category">{p.category}</span>
                            <span class="post-card__placeholder-title">{p.title}</span>
                            <span class="post-card__placeholder-hint">+ Upload Image</span>
                          </div>
                        )}
                      </div>
                      <div class="post-card__info">
                        <span class="post-card__title-label">{p.title}</span>
                        <span class="post-card__category-badge">{p.category}</span>
                      </div>
                    </a>
                  ))}
                  {posts.filter(p => p.col === 1).map(p => (
                    <a href={`/posts/${p.slug}`} class="post-card" tabindex="-1" aria-hidden="true">
                      <div class="post-card__image-container" style={`aspect-ratio: ${p.aspect};`}>
                        {p.image ? (
                          <img src={p.image} alt={p.title} class="post-card__img" loading="lazy" />
                        ) : (
                          <div class="post-card__placeholder">
                            <span class="post-card__placeholder-category">{p.category}</span>
                            <span class="post-card__placeholder-title">{p.title}</span>
                            <span class="post-card__placeholder-hint">+ Upload Image</span>
                          </div>
                        )}
                      </div>
                      <div class="post-card__info">
                        <span class="post-card__title-label">{p.title}</span>
                        <span class="post-card__category-badge">{p.category}</span>
                      </div>
                    </a>
                  ))}
                </div>
              </div>
              <!-- column 2 -->
              <div class="masonry__col" data-col>
                <div class="masonry__col-inner">
                  {posts.filter(p => p.col === 2).map(p => (
                    <a href={`/posts/${p.slug}`} class="post-card" aria-label={`View ${p.title}`}>
                      <div class="post-card__image-container" style={`aspect-ratio: ${p.aspect};`}>
                        {p.image ? (
                          <img src={p.image} alt={p.title} class="post-card__img" loading="lazy" />
                        ) : (
                          <div class="post-card__placeholder">
                            <span class="post-card__placeholder-category">{p.category}</span>
                            <span class="post-card__placeholder-title">{p.title}</span>
                            <span class="post-card__placeholder-hint">+ Upload Image</span>
                          </div>
                        )}
                      </div>
                      <div class="post-card__info">
                        <span class="post-card__title-label">{p.title}</span>
                        <span class="post-card__category-badge">{p.category}</span>
                      </div>
                    </a>
                  ))}
                  {posts.filter(p => p.col === 2).map(p => (
                    <a href={`/posts/${p.slug}`} class="post-card" tabindex="-1" aria-hidden="true">
                      <div class="post-card__image-container" style={`aspect-ratio: ${p.aspect};`}>
                        {p.image ? (
                          <img src={p.image} alt={p.title} class="post-card__img" loading="lazy" />
                        ) : (
                          <div class="post-card__placeholder">
                            <span class="post-card__placeholder-category">{p.category}</span>
                            <span class="post-card__placeholder-title">{p.title}</span>
                            <span class="post-card__placeholder-hint">+ Upload Image</span>
                          </div>
                        )}
                      </div>
                      <div class="post-card__info">
                        <span class="post-card__title-label">{p.title}</span>
                        <span class="post-card__category-badge">{p.category}</span>
                      </div>
                    </a>
                  ))}
                </div>
              </div>
              <!-- column 3 -->
              <div class="masonry__col" data-col>
                <div class="masonry__col-inner">
                  {posts.filter(p => p.col === 3).map(p => (
                    <a href={`/posts/${p.slug}`} class="post-card" aria-label={`View ${p.title}`}>
                      <div class="post-card__image-container" style={`aspect-ratio: ${p.aspect};`}>
                        {p.image ? (
                          <img src={p.image} alt={p.title} class="post-card__img" loading="lazy" />
                        ) : (
                          <div class="post-card__placeholder">
                            <span class="post-card__placeholder-category">{p.category}</span>
                            <span class="post-card__placeholder-title">{p.title}</span>
                            <span class="post-card__placeholder-hint">+ Upload Image</span>
                          </div>
                        )}
                      </div>
                      <div class="post-card__info">
                        <span class="post-card__title-label">{p.title}</span>
                        <span class="post-card__category-badge">{p.category}</span>
                      </div>
                    </a>
                  ))}
                  {posts.filter(p => p.col === 3).map(p => (
                    <a href={`/posts/${p.slug}`} class="post-card" tabindex="-1" aria-hidden="true">
                      <div class="post-card__image-container" style={`aspect-ratio: ${p.aspect};`}>
                        {p.image ? (
                          <img src={p.image} alt={p.title} class="post-card__img" loading="lazy" />
                        ) : (
                          <div class="post-card__placeholder">
                            <span class="post-card__placeholder-category">{p.category}</span>
                            <span class="post-card__placeholder-title">{p.title}</span>
                            <span class="post-card__placeholder-hint">+ Upload Image</span>
                          </div>
                        )}
                      </div>
                      <div class="post-card__info">
                        <span class="post-card__title-label">{p.title}</span>
                        <span class="post-card__category-badge">{p.category}</span>
                      </div>
                    </a>
                  ))}
                </div>
              </div>
            </div>
            <!-- scroll height generator -->
            <div class="scroll-mimic"></div>
          </div>

          <!-- category sidebar -->
          {categories.length > 0 && (
            <nav class="sidebar" aria-label="Post categories">
              <div class="sidebar-highlight"></div>
              <div class="sidebar-viewport" data-sidebar-viewport>
                <div class="sidebar__inner">
                  {categories.map(cat => (
                    <span class="sidebar__item">
                      {cat.label}
                    </span>
                  ))}
                </div>
              </div>
            </nav>
          )}
        </>
      )}
    </main>

    <script is:inline>
      const container = document.querySelector("[data-masonry-container]");
      const columns = document.querySelectorAll("[data-col]");

      if (container && columns.length > 0) {
        const colStates = Array.from(columns).map((col) => {
          const inner = col.querySelector(".masonry__col-inner");
          const cards = inner ? inner.querySelectorAll(".post-card:not([aria-hidden])") : [];
          return {
            element: col,
            inner: inner,
            cards: cards,
            groupHeight: 0,
          };
        });

        const measureColumns = () => {
          colStates.forEach((state) => {
            if (!state.inner) return;
            let h = 0;
            state.cards.forEach((card) => {
              h += card.getBoundingClientRect().height;
            });
            const gap = parseFloat(getComputedStyle(state.inner).gap) || 24;
            h += gap * state.cards.length;
            state.groupHeight = h;
          });
        };

        const setInitialPositions = () => {
          measureColumns();
          colStates.forEach((state) => {
            if (state.groupHeight > 0) {
              state.element.scrollTop = state.groupHeight;
            }
          });
        };

        // Initialize scroll positions
        let lastScrollTop = 5000;
        container.scrollTop = 5000;
        setInitialPositions();

        const syncScroll = () => {
          const currentScrollTop = container.scrollTop;
          const delta = currentScrollTop - lastScrollTop;
          lastScrollTop = currentScrollTop;

          colStates.forEach((state, index) => {
            if (state.groupHeight === 0) return;
            
            // Flip direction for middle column (index 1)
            const currentDelta = (index === 1) ? -delta : delta;
            let newScrollTop = state.element.scrollTop + currentDelta;

            // Wrap each column independently based on its group height
            if (newScrollTop <= 0) {
              newScrollTop += state.groupHeight;
            } else if (newScrollTop >= state.groupHeight * 2 - state.element.clientHeight) {
              newScrollTop -= state.groupHeight;
            }

            state.element.scrollTop = newScrollTop;
          });

          // Loop container scroll boundaries
          if (currentScrollTop < 2000 || currentScrollTop > 8000) {
            container.scrollTop = 5000;
            lastScrollTop = 5000;
          }
        };

        container.addEventListener("scroll", syncScroll, { passive: true });
        window.addEventListener("load", setInitialPositions);
        window.addEventListener("resize", () => {
          measureColumns();
        });
      }

      // Sidebar: dynamically bold the item centered in the highlight rectangle & resize highlight
      const sidebarViewport = document.querySelector("[data-sidebar-viewport]");
      const sidebarHighlight = document.querySelector(".sidebar-highlight");
      if (sidebarViewport) {
        const updateCenteredItem = () => {
          const items = sidebarViewport.querySelectorAll(".sidebar__item");
          const viewportRect = sidebarViewport.getBoundingClientRect();
          const centerY = viewportRect.top + viewportRect.height / 2;
          let closestItem = null;
          let closestDist = Infinity;

          items.forEach((item) => {
            const itemRect = item.getBoundingClientRect();
            const itemCenterY = itemRect.top + itemRect.height / 2;
            const dist = Math.abs(itemCenterY - centerY);
            if (dist < closestDist) {
              closestDist = dist;
              closestItem = item;
            }
          });

          items.forEach((item) => {
            item.classList.toggle("sidebar__item--active", item === closestItem);
          });

          if (closestItem && sidebarHighlight) {
            const itemRect = closestItem.getBoundingClientRect();
            // Dynamically fit highlight rectangle around active word with suitable horizontal & vertical padding
            const paddingX = 16;
            const paddingY = 4;
            sidebarHighlight.style.width = `${Math.round(itemRect.width + paddingX)}px`;
            sidebarHighlight.style.height = `${Math.round(itemRect.height + paddingY)}px`;
          }
        };

        const items = sidebarViewport.querySelectorAll(".sidebar__item");
        items.forEach((item) => {
          item.addEventListener("click", () => {
            item.scrollIntoView({ behavior: "smooth", block: "center" });
          });
        });

        sidebarViewport.addEventListener("scroll", updateCenteredItem, { passive: true });
        window.addEventListener("load", updateCenteredItem);
        window.addEventListener("resize", updateCenteredItem);
        updateCenteredItem();
      }
    </script>
  </body>
</html>

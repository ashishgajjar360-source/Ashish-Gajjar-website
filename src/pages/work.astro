---
import "../Style/global.css";
import "../Style/work-page.css";
import HeaderNav from "../components/HeaderNav.astro";

const printMediaFolders = [
  {
    name: "Branding",
    intro: ["Print identity,", "brand guidelines,", "and paper crafts."],
    tagline: "Explore Print Branding",
  },
  {
    name: "Packaging",
    intro: ["Tactile materials,", "box structures,", "and eco packaging."],
    tagline: "Explore Packaging",
  },
  {
    name: "Invitation Cards",
    intro: ["Custom typography,", "foil press,", "and event cards."],
    tagline: "Explore Invitation Cards",
  },
  {
    name: "Advertisement Banners",
    intro: ["Large format print,", "posters,", "and bill boards."],
    tagline: "Explore Print Banners",
  },
];

const digitalMediaFolders = [
  {
    name: "Branding",
    intro: ["Digital brand marks,", "color systems,", "and guidelines."],
    tagline: "Explore Digital Branding",
  },
  {
    name: "Iconography",
    intro: ["Custom icon sets,", "vector glyphs,", "and interface symbols."],
    tagline: "Explore Iconography",
  },
  {
    name: "UI Design",
    intro: ["Web & mobile interfaces,", "design systems,", "and flow."],
    tagline: "Explore UI Design",
  },
  {
    name: "Illustrations",
    intro: ["Digital artwork,", "concept art,", "and character forms."],
    tagline: "Explore Illustrations",
  },
  {
    name: "Thumbnails",
    intro: ["Cover art,", "high-CTR visuals,", "and media thumbs."],
    tagline: "Explore Thumbnails",
  },
  {
    name: "Graphics",
    intro: ["Social graphics,", "promotional visuals,", "and media."],
    tagline: "Explore Digital Graphics",
  },
  {
    name: "Videos",
    intro: ["Motion design,", "video edits,", "and reel sequences."],
    tagline: "Explore Videos",
  },
];

// Duplicate lists 5 times for seamless infinite looping
const loopedPrintMediaFolders = Array(5).fill(printMediaFolders).flat();
const loopedDigitalMediaFolders = Array(5).fill(digitalMediaFolders).flat();
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>Work — Ashish Gajjar</title>
  </head>
  <body>
    <main class="cross-stage">
      <div class="work-header-wrapper">
        <HeaderNav currentLabel="Work" currentHref="/work" />
      </div>

      <!-- 3D Perspective Grid Background (Ceiling & Floor) -->
      <div class="perspective-bg" aria-hidden="true">
        <div class="perspective-grid--top"></div>
        <div class="perspective-grid--bottom"></div>
      </div>

      <!-- Cross Layout Wrapper -->
      <div class="cross-stage__inner">
        <!-- Vertical Column (Print Media Cards) -->
        <div
          class="cross-column-viewport"
          data-column-viewport
          data-count={printMediaFolders.length}
        >
          <div class="cross-column-track">
            {
              loopedPrintMediaFolders.map((folder) => (
                <a
                  href="/specificwork"
                  class="card"
                  aria-label={`View ${folder.name} in Print Media`}
                >
                  <h4 class="frame__nav">Print Media</h4>
                  <p class="card__intro">
                    {folder.intro.map((line: string, idx: number) => (
                      <>
                        {line}
                        {idx < folder.intro.length - 1 && <br />}
                      </>
                    ))}
                  </p>
                  <p class="card__title">{folder.name}</p>
                  <p class="card__tagline">{folder.tagline}</p>
                </a>
              ))
            }
          </div>
        </div>

        <!-- Horizontal Row (Digital Media Cards) -->
        <div
          class="cross-row-viewport"
          data-row-viewport
          data-count={digitalMediaFolders.length}
        >
          <div class="cross-row-track">
            {
              loopedDigitalMediaFolders.map((folder) => (
                <a
                  href="/specificwork"
                  class="card"
                  aria-label={`View ${folder.name} in Digital Media`}
                >
                  <h4 class="frame__nav">Digital Media</h4>
                  <p class="card__intro">
                    {folder.intro.map((line: string, idx: number) => (
                      <>
                        {line}
                        {idx < folder.intro.length - 1 && <br />}
                      </>
                    ))}
                  </p>
                  <p class="card__title">{folder.name}</p>
                  <p class="card__tagline">{folder.tagline}</p>
                </a>
              ))
            }
          </div>
        </div>
      </div>
    </main>

    <script is:inline>
      const columnViewport = document.querySelector("[data-column-viewport]");
      const rowViewport = document.querySelector("[data-row-viewport]");

      if (columnViewport && rowViewport) {
        let activeAxis = "row"; // "column" or "row"
        let rAFId = null;

        const setContainerZIndex = (axis) => {
          activeAxis = axis;
          if (axis === "column") {
            columnViewport.style.zIndex = "10";
            rowViewport.style.zIndex = "2";
          } else {
            rowViewport.style.zIndex = "10";
            columnViewport.style.zIndex = "2";
          }
        };

        const checkColumnLoop = () => {
          const cards = columnViewport.querySelectorAll(".card");
          const count = parseInt(columnViewport.dataset.count || "4", 10);
          if (cards.length < count * 3) return;

          const setLength = cards[count].offsetTop - cards[0].offsetTop;
          if (!setLength) return;

          if (columnViewport.scrollTop < setLength * 1) {
            columnViewport.scrollTop += setLength * 2;
          } else if (columnViewport.scrollTop > setLength * 3) {
            columnViewport.scrollTop -= setLength * 2;
          }
        };

        const checkRowLoop = () => {
          const cards = rowViewport.querySelectorAll(".card");
          const count = parseInt(rowViewport.dataset.count || "7", 10);
          if (cards.length < count * 3) return;

          const setLength = cards[count].offsetLeft - cards[0].offsetLeft;
          if (!setLength) return;

          if (rowViewport.scrollLeft < setLength * 1) {
            rowViewport.scrollLeft += setLength * 2;
          } else if (rowViewport.scrollLeft > setLength * 3) {
            rowViewport.scrollLeft -= setLength * 2;
          }
        };

        const initLoopScroll = () => {
          const colCards = columnViewport.querySelectorAll(".card");
          const colCount = parseInt(columnViewport.dataset.count || "4", 10);
          if (colCards.length >= colCount * 3) {
            const colSetLength = colCards[colCount].offsetTop - colCards[0].offsetTop;
            if (colSetLength && columnViewport.scrollTop === 0) {
              const midCardIndex = colCount * 2;
              columnViewport.scrollTop =
                colCards[midCardIndex].offsetTop -
                (columnViewport.clientHeight - colCards[midCardIndex].offsetHeight) / 2;
            }
          }

          const rowCards = rowViewport.querySelectorAll(".card");
          const rowCount = parseInt(rowViewport.dataset.count || "7", 10);
          if (rowCards.length >= rowCount * 3) {
            const rowSetLength = rowCards[rowCount].offsetLeft - rowCards[0].offsetLeft;
            if (rowSetLength && rowViewport.scrollLeft === 0) {
              const midCardIndex = rowCount * 2;
              rowViewport.scrollLeft =
                rowCards[midCardIndex].offsetLeft -
                (rowViewport.clientWidth - rowCards[midCardIndex].offsetWidth) / 2;
            }
          }
        };

        const updateCardsInViewport = (viewport, isVertical, isInactiveAxis) => {
          const cards = viewport.querySelectorAll(".card");
          if (!cards.length) return;

          const vpRect = viewport.getBoundingClientRect();
          const vpCenter = isVertical
            ? vpRect.top + vpRect.height / 2
            : vpRect.left + vpRect.width / 2;
          const halfSpan = isVertical ? vpRect.height / 2 : vpRect.width / 2;

          cards.forEach((card) => {
            const cardRect = card.getBoundingClientRect();
            const cardCenter = isVertical
              ? cardRect.top + cardRect.height / 2
              : cardRect.left + cardRect.width / 2;

            const offset = (cardCenter - vpCenter) / (halfSpan || 1);
            // Normalized distance ratio: 0 at center, 1 at viewport boundary
            const distRatio = Math.min(1, Math.abs(offset));
            const direction = offset < 0 ? 1 : -1;

            if (isVertical) {
              const rotateX = -direction * distRatio * 20;
              const scale = 1 - distRatio * 0.08;
              card.style.setProperty("--card-rotate-x", `${rotateX.toFixed(2)}deg`);
              card.style.setProperty("--card-rotate-y", "0deg");
              card.style.setProperty("--card-scale", scale.toFixed(3));
            } else {
              const rotateY = direction * distRatio * 20;
              const scale = 1 - distRatio * 0.08;
              card.style.setProperty("--card-rotate-x", "0deg");
              card.style.setProperty("--card-rotate-y", `${rotateY.toFixed(2)}deg`);
              card.style.setProperty("--card-scale", scale.toFixed(3));
            }

            // Centered card gets highest z-index (100) inside its container
            const zIndex = Math.max(1, Math.round(100 - distRatio * 80));

            card.style.setProperty("--card-z-index", String(zIndex));

            if (isInactiveAxis) {
              const opacity = Math.min(1, Math.max(0, distRatio / 0.4));
              card.style.opacity = opacity.toFixed(2);
              card.style.pointerEvents = opacity < 0.1 ? "none" : "auto";
            } else {
              card.style.opacity = "1";
              card.style.pointerEvents = "auto";
            }
          });
        };

        const updateAllCards = () => {
          rAFId = null;
          updateCardsInViewport(columnViewport, true, activeAxis !== "column");
          updateCardsInViewport(rowViewport, false, activeAxis !== "row");
        };

        const requestCardsUpdate = () => {
          if (!rAFId) {
            rAFId = requestAnimationFrame(updateAllCards);
          }
        };

        // Native scroll listeners — just like the home page.
        // The browser handles all scroll physics (momentum, easing, snap).
        // JS only updates card perspective transforms.
        columnViewport.addEventListener(
          "scroll",
          () => {
            setContainerZIndex("column");
            checkColumnLoop();
            requestCardsUpdate();
          },
          { passive: true },
        );

        rowViewport.addEventListener(
          "scroll",
          () => {
            setContainerZIndex("row");
            checkRowLoop();
            requestCardsUpdate();
          },
          { passive: true },
        );

        // Hover & touch activation
        columnViewport.addEventListener("mouseenter", () => {
          setContainerZIndex("column");
          requestCardsUpdate();
        });

        rowViewport.addEventListener("mouseenter", () => {
          setContainerZIndex("row");
          requestCardsUpdate();
        });

        columnViewport.addEventListener(
          "touchstart",
          () => {
            setContainerZIndex("column");
            requestCardsUpdate();
          },
          { passive: true },
        );

        rowViewport.addEventListener(
          "touchstart",
          () => {
            setContainerZIndex("row");
            requestCardsUpdate();
          },
          { passive: true },
        );

        // Wheel: route scroll to correct viewport based on gesture direction.
        // When the active (top z-index) viewport can't scroll in the wheel direction,
        // redirect the delta to the other viewport.
        window.addEventListener(
          "wheel",
          (e) => {
            const absDx = Math.abs(e.deltaX);
            const absDy = Math.abs(e.deltaY);

            // Determine intended axis from wheel gesture
            if (absDx > absDy + 2) {
              // Clearly horizontal gesture (trackpad swipe left/right)
              if (activeAxis !== "row") {
                setContainerZIndex("row");
                requestCardsUpdate();
              }
              rowViewport.scrollLeft += e.deltaX;
              checkRowLoop();
              requestCardsUpdate();
            } else if (absDy > absDx + 2) {
              // Clearly vertical gesture (mouse wheel or trackpad swipe up/down)
              if (activeAxis !== "column") {
                setContainerZIndex("column");
                requestCardsUpdate();
              }
              columnViewport.scrollTop += e.deltaY;
              checkColumnLoop();
              requestCardsUpdate();
            } else {
              // Ambiguous — scroll the currently active axis
              if (activeAxis === "column") {
                columnViewport.scrollTop += e.deltaY || e.deltaX;
                checkColumnLoop();
              } else {
                rowViewport.scrollLeft += e.deltaX || e.deltaY;
                checkRowLoop();
              }
              requestCardsUpdate();
            }
          },
          { passive: true },
        );

        const fitCardTitles = () => {
          document.querySelectorAll(".card").forEach((card) => {
            const title = card.querySelector(".card__title");
            if (!title) return;

            title.style.fontSize = "";
            const maxW = card.clientWidth * 0.92;
            let currentSize = parseFloat(window.getComputedStyle(title).fontSize);

            while (title.scrollWidth > maxW && currentSize > 32) {
              currentSize -= 1;
              title.style.fontSize = `${currentSize}px`;
            }
          });
        };

        // Initial state & window resize binding
        setContainerZIndex("row");
        initLoopScroll();
        updateAllCards();
        fitCardTitles();
        window.addEventListener("load", () => {
          initLoopScroll();
          updateAllCards();
          fitCardTitles();
        });
        window.addEventListener(
          "resize",
          () => {
            updateAllCards();
            fitCardTitles();
          },
          { passive: true },
        );
      }
    </script>
  </body>
</html>
